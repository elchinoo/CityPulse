# Copy to .env (git-ignored). Never commit real credentials. LOCAL development only.
# Generate a password:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://citypulse:${POSTGRES_PASSWORD}@127.0.0.1:5434/citypulse

# api = gateway + dashboard + status engine; sim = simulator only; all = both (default)
# CITYPULSE_ROLE=all
# SIM_SENSORS=3000
# SIM_SPEED=1
# CITYPULSE_CITY=default   # the built-in simulator's city (a-z, 0-9, _ and -, up to 32 characters)

# Optional: push CityPulse's own health to PagerLens (an ingest-scope token created in PagerLens).
# PAGERLENS_URL=http://127.0.0.1:8001
# PAGERLENS_TOKEN=
