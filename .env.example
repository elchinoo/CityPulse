# Copy to .env (git-ignored). Never commit real credentials. LOCAL development only.
# Generate a password:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://citypulse:${POSTGRES_PASSWORD}@127.0.0.1:5434/citypulse

# api = gateway + dashboard + status engine; sim = simulator only; all = both (default)
# CITYPULSE_ROLE=all
# SIM_SENSORS=3000
# SIM_SPEED=1
# REQUIRED for the roles sim and all (the docker compose default), no default value: the built-in simulator's city
# (a-z, 0-9, _ and -, up to 32 characters; "default" is not allowed). Not needed with CITYPULSE_ROLE=api.
CITYPULSE_CITY=paris

# Optional: push CityPulse's own health to PagerLens (an ingest-scope token created in PagerLens).
# PAGERLENS_URL=http://127.0.0.1:8001
# PAGERLENS_TOKEN=

# Optional: AIDB mode (EDB AI Accelerator in the database; README "AIDB mode"). Default app = nothing of it runs.
# CITYPULSE_RETRIEVAL_BACKEND=app
# The platform secret that opens the seal key of the AIDB definitions (only when the switch is aidb): generate one, do not put a real one here.
# CITYPULSE_ENCRYPTION_KEY=
# `citypulse aidb-setup` asks for the admin connection string; do NOT keep it in a compose or env file.
